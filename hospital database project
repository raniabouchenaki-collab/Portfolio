#ifndef DOCTORS_H
#define DOCTORS_H

#include <iostream>
#include <string>
#include <vector>
#include <utility>
using namespace std;

class Doctors {

private:   

        string d_firsname;
        string d_lastname;
        long int d_ID;
        string speciality;
        int yearsofexp;
        double basesalary;
        double perfbonus;

public: 

        //setter functions
        void setdfn (string dfn) {d_firsname=dfn; };
        void setdln (string dln) {d_lastname=dln; };
        void setdid (long int did ){d_ID=did; };
        void setsp (string sp) {speciality=sp; };
        void setyoe (int yoe ){yearsofexp=yoe; };
        void setbs (double bs ){basesalary=bs; };
        void setpb (double pb ){perfbonus=pb; };

        //getter functions
        string getdfn() { return d_firsname; };
        string getdln() { return d_lastname; };
        long int getdid() { return d_ID; };
        string getsp() { return speciality; };
        int getyoe() { return yearsofexp; };
        double getbs() { return basesalary; };
        double getpb() { return perfbonus; };

        //member functions
        double Calculate_salary(double bs,double pb) { 
             double salarywithbonus; 

             salarywithbonus= bs +(bs*pb); //computes salary with bonus
             return salarywithbonus; //returns it
             };

       void Print_Doctor_Info(){  //display of doctor info, multiple couts used for program readability
    
        cout<<"Doctor's name: "<<d_firsname<<d_lastname<<"\n";
        cout<<"Doctor's ID: "<<d_ID<<"\n";
        cout<<"Speciality: "<<speciality<<"\n";
        cout<<"years of experience: "<<yearsofexp<<"\n";
        cout<<"Base salary: "<<basesalary<<"\n";
        cout<<"Perfomance bonus (percentage from 0-1): "<<perfbonus<<"\n";
        cout<<"Yearly salary (with bonus): "<<Calculate_salary(basesalary,perfbonus)<<"\n";
         };   
};
#endif

