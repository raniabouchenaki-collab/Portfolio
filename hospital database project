#ifndef PATIENTS_H
#define PATIENTS_H

#include <iostream>
#include <string>
#include <vector>
#include <utility>
using namespace std;

class Patients {
private:   
            string p_firstname;
            string p_lastname;
            long int p_ID;
            long int d_ID; //assigned doctor's id
            string datebirth;
            string bloodtype;
            string diagnosis;
            string admisiondate;
            string dischargedate;

public:
            // setter functions
            void setpfn (string pfn) {p_firstname=pfn; };
            void setpln (string pln) {p_lastname=pln; };
            void setpid (long int pid ){p_ID=pid; };
            void setdid (long int did ){d_ID=did;};
            void setdb (string db){datebirth=db;};
            void setbt (string bt){bloodtype=bt;};
            void setdia (string dia){diagnosis=dia;};
            void setad (string ad){admisiondate=ad;};
            void setdd (string dd) {dischargedate=dd;};

           //getter functions 
           string getpfn() { return p_firstname; };
           string getpln() { return p_lastname; };
           long int getpid() { return p_ID; };
           long int getdid() { return d_ID; };
           string getdb() { return datebirth; };
           string getbt() { return bloodtype; };
           string getdia() { return diagnosis; };
           string getad() { return admisiondate; };
           string getdd() { return dischargedate;};

           // member functions     
    std::string Patient_status(string n){ 
        // finds words in n string
        if (n.find("critical") != std::string::npos) {
            return "critical"; }

         if (n.find("moderate") != std::string::npos) {
            return "moderate";}
        else {
        return "Stable";};};
                        
    void Print_Patient_Info(){  //display of patient info, multiple couts used for program readability
    
        cout<<"Patient's name: "<<p_firstname<<p_lastname<<"\n";
        cout<<"Patient ID: "<<p_ID<<"\n";
        cout<<"Assigned doctor's ID: "<<d_ID<<"\n";
        cout<<"Date of birth: "<<datebirth<<"\n";
        cout<<"Blood type: "<<bloodtype<<"\n";
        cout<<"Diagnosis: "<<Patient_status(diagnosis)<<"\n";
        cout<<"Date of admission: "<<admisiondate<<"\n";
        cout<<"Discharge date: "<<dischargedate<<"\n";
    }; 
};
#endif

// hospital .h file containing all main functions

#ifndef HOSPITAL_H
#define HOSPITAL_H

#include "Patients.h"
#include "Doctors.h"
#include <fstream>
#include <sstream>
#include <iostream>
#include <string>
#include <vector>
#include <utility>
using namespace std;

class hospital {

private: 
        vector<Patients>* allPatients;
        vector<Doctors>* allDoctors;

public:  
        //constructor
         hospital(string pFile, string dFile) {  
         allPatients = new vector<Patients>();   //initialises both vectors
         allDoctors = new vector<Doctors>();  
        
         // for loop to read patient.txt file since we know the amount of iterations 
        ifstream p_in(pFile);
        if (p_in.is_open()) {
            int pCount;
            p_in >> pCount;  //gets the amount of patients from the file to put it in for loop
            p_in.ignore();  //skips line because we start at line 3

            for (int i = 0; i < pCount; i++) { 
                string line;
                if (getline(p_in, line)) {
                    stringstream ss(line);
                    string f, l, pid, did, dob, bt, diag, adm, dis;

                 //gets everthing and puts them in the temporary strings to pass them to the class setter functions that will set them as the right variable 
                    getline(ss, f, ','); getline(ss, l, ',');
                    getline(ss, pid, ','); getline(ss, did, ',');
                    getline(ss, dob, ','); getline(ss, bt, ',');
                    getline(ss, diag, ','); getline(ss, adm, ',');
                    getline(ss, dis, ','); 

                    Patients p; 
                    p.setpfn(f); p.setpln(l);
                    p.setpid(stol(pid)); p.setdid(stol(did));
                    p.setdb(dob); p.setbt(bt);
                    p.setdia(diag); p.setad(adm); p.setdd(dis);

                    // adds each new patient to the vector to the previously made patient vector
                    allPatients->push_back(p); }  }
        p_in.close(); } // closes patient file
        // The same for loop is used but for the doctors.txt file
        ifstream d_in(dFile);
        if (d_in.is_open()) {
            int dCount;
            d_in >> dCount; 
            d_in.ignore();

            for (int i = 0; i < dCount; i++) {
                string line;
                if (getline(d_in, line)) {
                    stringstream ss(line);
                    string df, dl, did, sp, yoe, bs, pb; //temporary strings 

                    getline(ss, df, ','); getline(ss, dl, ',');
                    getline(ss, did, ','); getline(ss, sp, ',');
                    getline(ss, yoe, ','); getline(ss, bs, ',');
                    getline(ss, pb, ',');
                    // setters declared in the doctors class
                    Doctors d;
                    d.setdfn(df); d.setdln(dl);
                    d.setdid(stol(did)); d.setsp(sp);
                    d.setyoe(stoi(yoe)); d.setbs(stod(bs));
                    d.setpb(stod(pb));

                    allDoctors->push_back(d);// adds to the alldoctors vectors
                }
            }
            d_in.close();  // closes the doctors file
         } } // end of the constructor

        //destructor needed to avoid problems if one file gets deleted 
        ~hospital() {
        delete allPatients;
        delete allDoctors; }

        //member functions
        
        void Find_Oldest_Patient() {   
         Patients* oldest = &((*allPatients)[0]); // we assume the oldest patient is the first
           
         for (auto& pat : *allPatients) { // we use a for loop trought the patients, the oldest will have the smallest db string
               if (pat.getdb() < oldest->getdb()) {
               oldest = &pat;   } } //compares alll strings until the true oldest is found

          cout << " The oldest Patient is : " << oldest->getpfn() << " " << oldest->getpln()<< " and they are born the " << oldest->getdb()<< endl; };
       
        int Count_Critical_Patients() { 
            int critcount; critcount=0;
            for (auto& pat : *allPatients) {
             if (pat.Patient_status(pat.getdia()) == "critical") {
                 critcount+=1;}}
                  return critcount; };
       
       
        void Doctors_By_Speciality (string sp) { //cout doctors that have the speciality 
           for (auto& doc : *allDoctors) {
             if (doc.getsp() == sp) {
                 cout << "Doctor found: " << doc.getdfn() << " " << doc.getdln() << endl; } 
                } };
        

        void Show_Patient_by_ID(long int p) { 
         bool found = false; 
           for (auto& pat : *allPatients) {
               if (pat.getpid() == p) {
                 cout << "patient's name: " << pat.getpfn() << " " << pat.getpln() << endl;
                 found = true; 
                 break;        // Exit the loop early once we find the patient 
               }  } 
          if (!found) { 
                  cout << "no patient with this id" << endl;  }} //message if we dont find a patient 
    
        void Show_Doctor_by_ID (long int d) {
        bool found =false;
          for (auto& doc : *allDoctors) {
             if (doc.getdid() == d) {
                  cout<<"Doctor's name: "<<doc.getdfn()<<" "<<doc.getdln()<<endl;
                  found = true;
                  break;} } 
        if (!found) {
               cout<<"No doctor with this id"<<endl; }  };

       
        void Show_Assigned_Doctor(long int pi) {
        for (auto& pat : *allPatients) {
            if (pat.getpid() == pi) {
            // We found the patient.
              bool doctorFound = false;
               for (auto& doc : *allDoctors) {
                if (pat.getdid() == doc.getdid()) { //loop trought the doctors until we find the one
                    cout << "The doctor assigned to this patient is: " 
                         << doc.getdfn() << " " << doc.getdln() << endl;
                    doctorFound = true;
                    break; // Stop looking for doctors once we found it (faster than letting the loop finish)
                } }
              if (!doctorFound) {
                cout << "Patient found, but assigned doctor ID " << pat.getdid() << " does not exist." << endl; }
                 return;  } }
         cout << "Patient with ID " << pi << " not found." << endl;}

        
        void Show_Assigned_Patients(long int di) {   
         for (auto& doc : *allDoctors) {
            if (doc.getdid() == di) {
            // We found the doctor
              bool patientfound = false;
               for (auto& pat : *allPatients) { // loop trought patient vector to find assigned doctor id and show all patients assigned
                if (doc.getdid() == pat.getdid()) {
                    cout << "Patient: " << pat.getpfn() << " " << pat.getpln() <<" is assigned to doctor: "<<doc.getdfn()<<" "<<doc.getdln()<<endl;
                    patientfound = true; } }
              if (!patientfound){
                cout << "Doctor found but they have no assigned patients "<< endl; }
                 return;  } } 
         cout << "Doctor with ID " << di << " not found." << endl; };

};
 #endif 

